[Unit]
Description=doormat local delegation daemon
After=local-fs.target

[Service]
Type=simple
# Replace these two paths with the Bun executable and checkout on this machine.
WorkingDirectory=%h/src/doormat
ExecStart=%h/.nix-profile/bin/bun --no-env-file %h/src/doormat/src/cli.ts daemon
Environment=PATH=%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/doormat/daemon.env
RuntimeDirectory=human-agent
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
